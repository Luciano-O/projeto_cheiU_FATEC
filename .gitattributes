* text=auto

# Texto versionado (gêmeos em texto)
*.md   text eol=lf
*.pq   text eol=lf
*.dax  text eol=lf
*.sql  text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.ps1  text eol=crlf
# O importador do VBE exige CRLF
*.bas  text eol=crlf
*.cls  text eol=crlf
*.frm  text eol=crlf

# CSVs brutos ficam byte a byte como a fonte publicou (encoding e quebras originais)
*.csv -text

# Binários
*.xlsx binary
*.xlsm binary
*.xls  binary
*.pbix binary
*.pdf  binary
*.png  binary
*.pptx binary
*.docx binary
*.dbf  binary
*.zip  binary
