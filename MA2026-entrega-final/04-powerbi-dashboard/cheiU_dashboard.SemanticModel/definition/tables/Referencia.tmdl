table Referencia
	lineageTag: 562e7d1a-ce38-557d-8807-232d0ad7703b

	measure 'Passageiros Publicados' = SUM(Referencia[passageiros_publicado])
		formatString: #,0
		displayFolder: Publicado
		lineageTag: 72f0c8c4-62fe-53dc-8ef9-f72f3e6072bf

	measure 'Passageiros Calculados (grupos oficiais)' = CALCULATE([Total de Passageiros], Grupos[grupo_oficial] = TRUE())
		formatString: #,0
		displayFolder: Publicado
		lineageTag: 1017f5e6-274e-5e55-8ec3-b51a4670237e

	measure 'Diferença % sobre o Publicado' = DIVIDE([Passageiros Calculados (grupos oficiais)] - [Passageiros Publicados], [Passageiros Publicados])
		formatString: 0.00%
		displayFolder: Publicado
		lineageTag: 74f9280f-58ad-5466-aa4b-736689da1da7

	column mes_inicio
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: a9285f8d-2978-57d8-a440-b37d5be77d3d
		summarizeBy: none
		sourceColumn: mes_inicio

		annotation UnderlyingDateTimeDataType = Date

	column grupo
		dataType: string
		isHidden
		lineageTag: 9d77dd17-4ad8-55bb-9557-0b7117cda38d
		summarizeBy: none
		sourceColumn: grupo

	column passageiros_publicado
		dataType: int64
		formatString: #,0
		lineageTag: 422574d5-b21b-531c-87c5-e043f2760bee
		summarizeBy: none
		sourceColumn: passageiros_publicado

	column origem_dado
		dataType: string
		lineageTag: 4a4aac57-c10a-578c-a857-566443ffeaab
		summarizeBy: none
		sourceColumn: origem_dado

	column fonte
		dataType: string
		lineageTag: a4d8eb84-dd34-5bee-8d0c-42b0e9f70571
		summarizeBy: none
		sourceColumn: fonte

	partition Referencia = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "vw_referencia_mensal"]}[Data]
				in
				    Dados

